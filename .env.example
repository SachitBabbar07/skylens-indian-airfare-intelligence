# Optional comma-separated development origins. Leaving this unset uses localhost defaults.
# An explicitly empty value disables cross-origin access.
# Wildcards are not accepted. Set CORS in the process environment.
# SKYLENS_CORS_ORIGINS=
# Legacy Groq API experiment. To enable it, set SKYLENS_EXPERIMENTAL_GROQ=true
# in the backend process environment. The Flights page never uses this experiment.
# The backend reads the following from the process environment or the ignored local .env.
# GROQ_API_KEY=
# GROQ_MODEL=
# GROQ_FREE_PLAN_CONFIRMED=
# The keyless Kiwi.com fare fallback is enabled by default.
# Set SKYLENS_KIWI_FARES_ENABLED=false in the backend process environment to disable it.
