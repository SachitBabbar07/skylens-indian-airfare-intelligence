# Optional comma-separated development origins. Leaving this unset uses localhost defaults.
# An explicitly empty value disables cross-origin access.
# Wildcards are not accepted. Set CORS in the process environment.
# SKYLENS_CORS_ORIGINS=
# The backend reads Groq settings from the process environment or the ignored local .env.
# GROQ_API_KEY=
# GROQ_MODEL=
# GROQ_FREE_PLAN_CONFIRMED=
