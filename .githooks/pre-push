#!/bin/sh
# Every pushed ancestry is scanned; local archival audit history never leaves.
set -eu
if [ -x .venv/Scripts/python.exe ]; then
  python_bin=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then
  python_bin=.venv/bin/python
else
  python_bin=python
fi
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/heads/archive/*)
      echo 'Refusing to publish a local archive branch.' >&2
      exit 1
      ;;
  esac
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  "$python_bin" scripts/repository_guard.py --history --ref "$local_sha"
done
